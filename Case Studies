    CheckValid -->|No| CalcGross[Gross = Consultation + Diagnostics + Treatment]
    
    CalcGross --> CheckDisc{Gross >= 5000}
    CheckDisc -->|Yes| Discount10[Concession = Gross * 0.10]
    CheckDisc -->|No| DiscountZero[Concession = 0]
    
